# URL base de la API.
# Por defecto se usa /api (ruta relativa) para aprovechar el proxy de Vite en desarrollo.
# El backend actual no configura CORS: si apuntás directo a http://localhost:8080/api
# el navegador bloqueará las requests salvo que habilites CORS en Spring.
VITE_API_URL=/api

# Los logins (/student/auth, /instructor/auth y /administrator/auth) viven fuera de /api
# y se resuelven con el proxy de Vite en desarrollo o el de nginx en producción.
# No hace falta configurar nada más: el front prueba los tres endpoints hasta que
# uno acepte las credenciales y deduce el rol del JWT devuelto.

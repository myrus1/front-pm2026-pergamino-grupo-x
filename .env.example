# URL base de la API.
# Por defecto se usa /api (ruta relativa) para aprovechar el proxy de Vite en desarrollo.
# El backend actual no configura CORS: si apuntás directo a http://localhost:8080/api
# el navegador bloqueará las requests salvo que habilites CORS en Spring.
VITE_API_URL=/api

# Opcional: si el backend expone POST /auth/login, indicá la ruta aquí
# (ej. /auth/login). Si se omite, se usa el modo demo por email.
# VITE_AUTH_ENDPOINT=/auth/login

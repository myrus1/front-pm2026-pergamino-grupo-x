server {
    # Railway inyecta PORT en runtime; en Docker local cae en el default del Dockerfile.
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # DNS real del contenedor (Docker/Railway), exportado por la imagen oficial.
    # Con proxy_pass usando variable, el host se resuelve en tiempo de request.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s;

    # Proxy hacia el backend Spring: mantiene la misma origen y evita CORS.
    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        # SNI y Host del upstream, necesarios si API_UPSTREAM es un dominio público.
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # Logins: viven fuera de /api (/student/auth, /instructor/auth, /administrator/auth).
    # Se usa una ruta exacta para no interceptar las rutas de React
    # (/student/catalog, /instructor/courses, etc.). El path se conserva igual.
    location ~ ^/(student|instructor|administrator)/auth$ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
    }

    # El index no se cachea para que los despliegues tomen efecto.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Assets con hash: cacheables a largo plazo.
    location ~* \.(?:js|css|svg|png|jpg|jpeg|gif|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA: cualquier ruta desconocida la resuelve React Router.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
